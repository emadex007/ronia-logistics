{
  "name": "ronia-logistics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ronia_logistics_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ronia_logistics_db --remote"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "rollup": "4.63.4",
    "lightningcss": "1.32.0"
  }
}
